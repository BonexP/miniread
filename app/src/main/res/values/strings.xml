    <!-- Advanced settings: help page -->
    <string name="nav_settings_help">Settings Help</string>
    <string name="settings_help_title">How to fill this page</string>
    <string name="settings_help_intro">This page only explains the settings. It changes nothing.</string>
    <string name="settings_help_open_for">Help: %1$s</string>
    <string name="settings_help_example_label">Example</string>
    <string name="settings_help_section_overview_title">What this does</string>
    <string name="settings_help_section_overview_body">When all conditions match, the app fetches images and other resources of the article itself and adds a Referer header. This is needed when an image host rejects requests coming from a reader. It does not block ads, does not change article text, and does not affect any site that is not matched.</string>
    <string name="settings_help_section_when_title">When to enable it</string>
    <string name="settings_help_section_when_body">Only when images are broken, blank or return 403, and only for a few feeds. Keep it off if you are not sure: off is the safe default and changes nothing.</string>
    <string name="settings_help_section_conditions_title">Four conditions must all be true</string>
    <string name="settings_help_section_conditions_body">1) The master switch is on.\n2) Your current server address contains one of the target domains.\n3) The article belongs to a whitelisted feed.\n4) That feed id is really in the list.\nMissing any one means nothing is intercepted. The status line on the settings page only means the configuration is complete; it does not mean every article is intercepted.</string>
    <string name="settings_help_section_domains_title">Target domains</string>
    <string name="settings_help_section_domains_body">Fill in a fragment of your server address. Matching is a case-insensitive contains check, so example.com also matches sub.example.com. Do not include https:// or a path. Separate several values with English commas. Leaving it empty means nothing is intercepted at all, not everything.</string>
    <string name="settings_help_section_domains_example">example.com\nmail.example.com</string>
    <string name="settings_help_section_feedids_title">Feed whitelist</string>
    <string name="settings_help_section_feedids_body">Only numeric feed ids, not titles. The safest way is to tap the picker and tick the feeds; each row shows its #id. An empty list means no article is intercepted. If a feed was deleted, its id is kept and shown in a separate section of the picker so you can remove it on purpose.</string>
    <string name="settings_help_section_feedids_example">101,102</string>
    <string name="settings_help_section_referer_title">Referer rules</string>
    <string name="settings_help_section_referer_body">Each rule is keyword=&gt;address, separated by English semicolons. The left side is matched against the request host with a case-sensitive contains check. Rules are evaluated top to bottom and the first match wins, so put specific keywords before broad ones. Entries without =&gt;, or with an empty side, are dropped.</string>
    <string name="settings_help_section_referer_example">images.example.com=&gt;https://example.com/</string>
    <string name="settings_help_section_effect_title">When it takes effect</string>
    <string name="settings_help_section_effect_body">Settings are written to this device immediately. An article that is already open will not reload by itself: go back to the list and open it again. Switching to another server re-evaluates the domain match. Turning the master switch off restores normal loading at once.</string>
    <string name="settings_help_section_backup_title">Export and backup</string>
    <string name="settings_help_section_backup_body">Export copies four lines in key=value form, which you can keep in any notes app. Import replaces all four fields at once, not only the line you copied, and you still need to tap Save. These settings live in DataStore, which is excluded from Android cloud backup, so switching devices requires a manual export and import.</string>
    <string name="settings_help_section_backup_example">enabled=true\ndomains=example.com\nfeedIds=101\nrefererRules=images.example.com=&gt;https://example.com/</string>
    <string name="settings_help_section_mistakes_title">Common mistakes</string>
    <string name="settings_help_section_mistakes_body">Using a Chinese comma instead of an English comma.\nPutting https:// inside a domain.\nTyping -&gt; instead of =&gt;.\nFilling in feed titles instead of #ids.\nPasting a whole feed URL as a domain.\nListing a broad rule before a specific one, which makes the specific rule never apply.</string>
    <string name="settings_help_section_privacy_title">Scope and privacy</string>
    <string name="settings_help_section_privacy_body">Only matching requests are re-fetched by the app. The configuration stays on this device and is never uploaded. Restore to default clears all four fields at once.</string>
</resources>
